# Generated by the native builds (beam local run native-libs, scripts/native/setup-native.sh) — never committed. Tracked counterparts that these
# deliberately do NOT match: build.gradle, settings.gradle, gradle.properties, and
# gradle/wrapper/gradle-wrapper.properties (the wrapper's pinned distribution URL).

# Machine-specific: absolute JDK 17 + Android SDK paths resolved by scripts/native/setup-native.sh.
Android/.native-build-env

# Gradle build output.
**/build/

# Gradle wrapper — bootstrapped on first build; the .jar is intentionally not committed.
**/gradlew
**/gradlew.bat
**/gradle-wrapper.jar
